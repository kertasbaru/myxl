# ==========================================
# 1. APPLICATION CORE
# ==========================================
NODE_ENV="development"
APP_NAME="MyXL API Public"
HOST="" 
PORT="5000"
TZ="Asia/Jakarta"

# ==========================================
# 2. SECURITY & LIMITS
# ==========================================
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="1000"

# ==========================================
# 3. DATABASE CONFIGURATION
# ==========================================
DATABASE_URL=""

DB_CONNECTION="mysql"
DB_HOST=""
DB_PORT="3306"
DB_DATABASE=""
DB_USERNAME=""
DB_PASSWORD=""

# ==========================================
# 4. PUBLIC ACCESS & CORS
# ==========================================
CORS_ORIGIN="*"
CORS_METHODS="GET,HEAD,PUT,PATCH,POST,DELETE"

# ==========================================
# 5. LOGGER CONFIGURATION
# ==========================================
LOG_LEVEL="debug"
LOG_DIR="logs"
LOG_FILENAME="app.log"
LOG_MAX_SIZE="10m"
LOG_MAX_FILES="14d"

# ==========================================
# 6. EXTERNAL SERVICE: MYXL INTEGRATION
# ==========================================
BASE_API_URL=""
BASE_CIAM_URL=""
UA=""
BASIC_AUTH=""

# ==========================================
# 7. EXTERNAL SERVICE: KEYS & SECRETS
# ==========================================
API_KEY=""
AX_FP_KEY=""
AX_API_SIG_KEY=""
XDATA_KEY=""
X_API_BASE_SECRET=""
X_SECRET=""
CIRCLE_MSISDN_KEY=""
